# Copy to .env and fill in. The real .env is git-ignored.

# Timezone for scheduled workflows.
TZ=Australia/Perth

# n8n public hostname and webhook base URL.
N8N_HOST=n8n.example.com
N8N_WEBHOOK_URL=https://n8n.example.com/

# n8n encryption key for stored credentials. Generate a random value and keep
# it only in your local .env (or 1Password); losing it loses saved creds.
N8N_ENCRYPTION_KEY=change-me-generate-a-long-random-string
