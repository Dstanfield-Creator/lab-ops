#!/bin/bash
# ─── Config ──────────────────────────────────────────────────────────────────
# Reachability + key-auth check across every host in ~/.ssh/config.
#
#   lab-ssh-check                 # check every alias
#   lab-ssh-check pve mcserver    # check just these
#   lab-ssh-check --quiet         # only print problems (cron/loop friendly)
#   lab-ssh-check --serial        # one at a time, for readable debugging
#   lab-ssh-check --all           # include hosts listed in SKIP below
#
# Hosts in SKIP are known-down or decommissioned: reported as [SKIP] and left
# out of the exit code, so a cron run only alarms on hosts meant to be up.
# Naming a skipped host explicitly checks it anyway.
#
# Exit 0 if every checked host authenticates, 1 otherwise.

SSH_CONFIG="$HOME/.ssh/config"
# Excluded from the exit code: aliases that are known-down, decommissioned,
# or only ever reached in the other direction.  Example: SKIP=(old-pi laptop)
SKIP=()
TCP_TIMEOUT=4         # seconds to wait for the TCP handshake
SSH_TIMEOUT=8         # seconds to wait for the SSH auth exchange

LOG_DIR="$HOME/.lab"
LOG_FILE="$LOG_DIR/lab-ssh-check-$(date +%Y%m%d).log"

QUIET=0
SERIAL=0
CHECK_ALL=0
TARGETS=()

for arg in "$@"; do
    case "$arg" in
        --quiet|-q)  QUIET=1 ;;
        --serial|-s) SERIAL=1 ;;
        --all|-a)    CHECK_ALL=1 ;;
        -h|--help)   sed -n '3,16p' "$0" | sed 's/^# \?//'; exit 0 ;;
        -*)          echo "Unknown option: $arg" >&2; exit 2 ;;
        *)           TARGETS+=("$arg") ;;
    esac
done
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail
mkdir -p "$LOG_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1
echo "=== lab-ssh-check started $(date '+%Y-%m-%d %H:%M:%S') ==="

[[ -r "$SSH_CONFIG" ]] || { echo "ERROR: no readable $SSH_CONFIG"; exit 1; }

# ── 1. Work out which aliases to check ───────────────────────────────────────
if (( ${#TARGETS[@]} )); then
    ALIASES=("${TARGETS[@]}")
else
    mapfile -t ALIASES < <(awk '
        /^[[:space:]]*[Hh]ost[[:space:]]/ {
            for (i = 2; i <= NF; i++)
                if ($i !~ /[*?!]/) print $i
        }' "$SSH_CONFIG")
fi
(( ${#ALIASES[@]} )) || { echo "ERROR: no host aliases found in $SSH_CONFIG"; exit 1; }

# An alias is skipped only when it is in SKIP, --all was not given, and the
# user did not name it explicitly - asking for a host always checks it.
is_skipped() {
    (( CHECK_ALL )) && return 1
    (( ${#TARGETS[@]} )) && return 1
    local a
    for a in "${SKIP[@]}"; do [[ "$a" == "$1" ]] && return 0; done
    return 1
}
echo "Checking ${#ALIASES[@]} host(s) from $SSH_CONFIG"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

# ── 2. Per-host check ────────────────────────────────────────────────────────
# Writes one record to $WORK/<n>: alias|target|status|detail
check_host() {
    local idx="$1" alias="$2"
    local cfg host port user status detail start ms out rc

    if is_skipped "$alias"; then
        printf '%s|%s|%s|%s\n' "$alias" "-" "SKIP" "in SKIP list - not checked" > "$WORK/$idx"
        return
    fi

    cfg="$(ssh -G "$alias" </dev/null 2>/dev/null)" || true
    host="$(awk '$1=="hostname"{print $2; exit}' <<<"$cfg")"
    port="$(awk '$1=="port"{print $2; exit}'     <<<"$cfg")"
    user="$(awk '$1=="user"{print $2; exit}'     <<<"$cfg")"

    if [[ -z "$host" ]]; then
        printf '%s|%s|%s|%s\n' "$alias" "?" "CONFIG" "no HostName resolved" > "$WORK/$idx"
        return
    fi

    # 2a. Is the port open? Cheaper than SSH, and separates DNS/DOWN from AUTH.
    #     NB: getent is no help here - it returns 2 for plain IPv4 literals -
    #     so resolution failure is read off the connect error instead.
    set +e
    out="$(timeout "$TCP_TIMEOUT" bash -c "exec 3<>/dev/tcp/$host/$port" 2>&1)"
    rc=$?
    set -e
    if (( rc != 0 )); then
        if grep -qiE 'name or service not known|temporary failure in name resolution|no address' <<<"$out"; then
            status="DNS";  detail="cannot resolve $host"
        elif (( rc == 124 )); then
            status="DOWN"; detail="no answer on port $port (${TCP_TIMEOUT}s timeout)"
        else
            status="DOWN"; detail="port $port refused or unreachable"
        fi
        printf '%s|%s|%s|%s\n' "$alias" "${user}@${host}:${port}" "$status" "$detail" > "$WORK/$idx"
        return
    fi

    # 2c. Does a key get us in? BatchMode forbids any prompt, so success
    #     means key auth alone - never a cached password or a typed one.
    # NB: %3N is not honoured on this box (prints full nanoseconds), so take
    # %N and divide rather than trusting the width modifier.
    start=$(date +%s%N)
    set +e
    out="$(ssh -o BatchMode=yes \
               -o ConnectTimeout="$SSH_TIMEOUT" \
               -o StrictHostKeyChecking=ask \
               "$alias" true 2>&1)"
    rc=$?
    set -e
    ms=$(( ( $(date +%s%N) - start ) / 1000000 ))

    if (( rc == 0 )); then
        status="OK";       detail="key auth in ${ms}ms"
    elif grep -qi 'REMOTE HOST IDENTIFICATION HAS CHANGED' <<<"$out"; then
        status="HOSTKEY!"; detail="host key CHANGED - investigate before connecting"
    elif grep -qi 'Host key verification failed' <<<"$out"; then
        status="HOSTKEY";  detail="key not in known_hosts (first contact?)"
    elif grep -qi 'Permission denied' <<<"$out"; then
        status="AUTH";     detail="reachable, but no key accepted"
    else
        status="ERR";      detail="$(tr '\n' ' ' <<<"$out" | grep -oE '[^ ].{0,70}' | head -1)"
    fi
    printf '%s|%s|%s|%s\n' "$alias" "${user}@${host}:${port}" "$status" "$detail" > "$WORK/$idx"
}

# ── 3. Run the checks ────────────────────────────────────────────────────────
if (( SERIAL )); then
    for i in "${!ALIASES[@]}"; do check_host "$i" "${ALIASES[$i]}"; done
else
    # NB: a bare `trap ... EXIT` is inherited by background subshells, so each
    # finishing job would wipe $WORK. Clear it in the child.
    for i in "${!ALIASES[@]}"; do
        ( trap - EXIT; check_host "$i" "${ALIASES[$i]}" ) &
    done
    wait || true
fi

# ── 4. Report ────────────────────────────────────────────────────────────────
ok=0; bad=0; skipped=0
if (( ! QUIET )); then
    printf '\n  %-12s %-38s %-9s %s\n' "ALIAS" "TARGET" "STATUS" "DETAIL"
    printf '  %-12s %-38s %-9s %s\n'   "-----" "------" "------" "------"
fi
for i in "${!ALIASES[@]}"; do
    [[ -f "$WORK/$i" ]] || continue
    IFS='|' read -r alias target status detail < "$WORK/$i"
    if [[ "$status" == "OK" ]]; then
        ok=$(( ok + 1 ))
        (( QUIET )) || printf '  %-12s %-38s %-9s %s\n' "$alias" "$target" "[OK]" "$detail"
    elif [[ "$status" == "SKIP" ]]; then
        skipped=$(( skipped + 1 ))
        (( QUIET )) || printf '  %-12s %-38s %-9s %s\n' "$alias" "$target" "[SKIP]" "$detail"
    else
        bad=$(( bad + 1 ))
        printf '  %-12s %-38s %-9s %s\n' "$alias" "$target" "[$status]" "$detail"
    fi
done

echo ""
echo "$ok/$(( ok + bad )) host(s) reachable with key auth.$( (( skipped )) && echo "  ($skipped skipped)" )"
echo "=== lab-ssh-check finished $(date '+%Y-%m-%d %H:%M:%S') ==="
(( bad == 0 ))
