# Optional overrides for lab-up / lab-down. Export these in your shell profile
# or `source` this file before running the scripts. Never commit real values.

# Where the Proxmox API token comes from (first match wins):
#   1. PROXMOX_TOKEN in the environment
#   2. the token file below (chmod 600)
#   3. 1Password CLI item below
#PROXMOX_TOKEN="PVEAPIToken=lab-agent@pve!lab-scripts=00000000-0000-0000-0000-000000000000"
OP_ITEM="pve-api-token"
OP_VAULT="Infra"
OP_FIELD="API Token Header"
TOKEN_FILE="$HOME/.config/lab/proxmox.token"
